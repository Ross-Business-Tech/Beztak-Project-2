# Copy to .env and fill in. Never commit .env. Every setting is optional except where marked.

# ---- Server ----
PORT=8080
DATA_DIR=./data                  # where the database file is kept (Docker uses /data)
# First sign-in. If ADMIN_PASSWORD is empty, a random password is printed once in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SECURE=auto               # auto | true | false  (use true when served over HTTPS)
TRUST_PROXY=false                # true when a host or load balancer sits in front (Render, Fly, nginx)
SESSION_HOURS=12

# ---- Safety ----
# Nothing is ever emailed to an employee automatically unless this is true AND the workflow allows it.
ALLOW_AUTO_SEND=false

# ---- AI provider ----
# Default: Claude through Anthropic's own API. Use your Anthropic API key.
AI_PROVIDER=anthropic            # anthropic | openai  (openai = any OpenAI-compatible service)
AI_API_KEY=                      # your Anthropic API key (sk-ant-...)
AI_MODEL=claude-haiku-5-5        # can also be changed in Settings
# For another provider: AI_PROVIDER=openai, AI_BASE_URL=https://openrouter.ai/api/v1 (or https://api.openai.com/v1,
# or http://localhost:11434/v1 for a local Ollama model), and an AI_MODEL name that provider uses.

# ---- Ticketing: Zoho Desk ----
TICKETING_ADAPTER=none           # none (use "Import and evaluate" in the app) | zohodesk
ZOHO_REGION=us                   # us | eu | in | au | jp | ca | sa | uk | cn  (where your Zoho account lives)
ZOHO_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_DEPARTMENT_ID=              # optional but recommended: only read this department (the HR queue)
INTAKE_STATUSES=Open             # which ticket statuses to pick up (comma separated)
POLL_SECONDS=300                 # how often to check for new tickets
BACKFILL_DAYS=0                  # 0 = only tickets created after first start
ZOHO_ASSIGNEES={}                # e.g. {"HR Director":"<zoho agent id>"} so "assign" blocks can work

# ---- Demo ----
SEED_SAMPLE_FILES=false          # true = start with made-up sample policies (demo only)
