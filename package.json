{
  "name": "starter-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-test.cjs",
    "publish:preview": "node scripts/herenow-publish.mjs preview",
    "build:server": "vite build -c vite.server.config.js",
    "start": "node dist-server/index.js",
    "test:server": "vite build -c vite.server.config.js --ssr server/test/e2e.test.js --outDir dist-test && node --test dist-test/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
